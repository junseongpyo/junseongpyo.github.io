{% set ui = i18n.locales[locale] %}
<!doctype html>
<html lang="{{ ui.htmlLang }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ site.description | escape }}" />
    <link rel="canonical" href="{{ i18n.siteUrl }}{{ ui.path }}" />
    {% for code, strings in i18n.locales %}<link rel="alternate" hreflang="{{ strings.htmlLang }}" href="{{ i18n.siteUrl }}{{ strings.path }}" />
    {% endfor %}<link rel="alternate" hreflang="x-default" href="{{ i18n.siteUrl }}/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{{ site.name | escape }}</title>
    {% if locale == "ko" %}<link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />{% endif %}
    <link rel="stylesheet" href="/styles.css" />
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-X61RL3PT4G"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-X61RL3PT4G");
    </script>
  </head>
  <body>
    <nav class="lang-switch" aria-label="{{ ui.switchAriaLabel | escape }}">
      {% for code in i18n.switcherOrder %}{% set target = i18n.locales[code] %}{% if code == locale %}<span class="active" aria-current="page" lang="{{ target.htmlLang }}">{{ target.switchLabel }}</span>{% else %}<a href="{{ target.path }}" hreflang="{{ target.htmlLang }}" lang="{{ target.htmlLang }}">{{ target.switchLabel }}</a>{% endif %}{% if not loop.last %}<span class="lang-sep" aria-hidden="true">|</span>{% endif %}{% endfor %}
    </nav>
    <div class="page">
      <div class="main">
        <header class="site-header">
          <div class="header-copy">
            <h1>{{ site.name | escape }}</h1>
            <div class="header-subtitle">{{ site.subtitle | escape }}</div>
            <div class="contact">
              {% for contact in site.contacts %}<a href="{{ contact.url | escape }}">{{ contact.label | escape }}</a>{% if not loop.last %}<span>|</span>{% endif %}{% endfor %}
            </div>
          </div>

          <figure class="profile-photo">
            <img
              src="{{ site.profile.src | rootPath | escape }}"
              alt="{{ site.profile.alt | escape }}"
              width="800"
              height="auto"
            />
          </figure>
        </header>

        <section id="about" aria-label="{{ ui.nav.about | escape }}">
          {% include "sections/about.njk" %}
        </section>

        <section id="publications" aria-label="{{ publications.heading | escape }}">
          {% include "sections/publications.njk" %}
        </section>

        <section id="research" aria-label="{{ ui.nav.research | escape }}">
          {% include "sections/research.njk" %}
        </section>

        <section id="work" aria-label="{{ ui.nav.work | escape }}">
          {% include "sections/work.njk" %}
        </section>

        <section id="misc" aria-label="{{ ui.nav.miscFull | escape }}">
          {% include "sections/misc.njk" %}
        </section>
      </div>

      <aside class="toc">
        <a href="#about" class="active">{{ ui.nav.about | escape }}</a>
        <a href="#publications">{{ ui.nav.publications | escape }}</a>
        <a href="#research">{{ ui.nav.research | escape }}</a>
        <a href="#work">{{ ui.nav.work | escape }}</a>
        <a href="#misc">{{ ui.nav.misc | escape }}</a>
      </aside>
    </div>

    <script>
      const tocLinks = document.querySelectorAll(".toc a");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              tocLinks.forEach((a) => a.classList.remove("active"));
              const active = document.querySelector(
                `.toc a[href="#${entry.target.id}"]`,
              );
              if (active) active.classList.add("active");
            }
          });
        },
        { rootMargin: "0px 0px -80% 0px" },
      );

      document
        .querySelectorAll("section[id]")
        .forEach((section) => observer.observe(section));

      document.querySelectorAll("a[href]").forEach((link) => {
        if (link.hostname && link.hostname !== location.hostname) {
          link.target = "_blank";
          link.rel = "noopener";
        }
      });
    </script>
  </body>
</html>
