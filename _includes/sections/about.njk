<p class="section-title">{{ about.heading | escape }}</p>

<div
  style="line-height: 1.7; color: var(--c-text-2); margin-bottom: 20px"
>
  {{ about.introductionHtml | safe }}
</div>

{% for topic in about.topics %}
  <p style="font-weight: 700; color: var(--c-text); margin-bottom: 4px">
    {{ topic.title | escape }}
  </p>
  <p style="line-height: 1.5; color: var(--c-text-2); margin-bottom: 24px">
    {{ topic.body | escape }}
  </p>
{% endfor %}

<p style="line-height: 1.5; color: var(--c-text-2)">
  {{ about.closing | escape }}
</p>
