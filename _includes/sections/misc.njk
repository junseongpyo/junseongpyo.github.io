<p class="section-title">{{ misc.projectsHeading | escape }}</p>
{% for project in misc.projects %}
  <div class="entry">
    <div class="entry-header">
      <span class="entry-title">{{ project.title | escape }}</span>
      <span class="entry-date">{{ project.period | escape }}</span>
    </div>
    <div class="entry-subtitle">{{ project.subtitle | escape }}</div>
    {% if project.highlights.length %}
      <ul>
        {% for highlight in project.highlights %}
          <li>{{ highlight | escape }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    {% if project.links.length %}
      <div class="pub-github">
        {% for link in project.links %}<a class="pub-link" href="{{ link.url | escape }}">{{ link.label | escape }}</a>{% if not loop.last %}<span class="pub-sep">·</span>{% endif %}{% endfor %}
      </div>
    {% endif %}
  </div>
{% endfor %}

<p class="section-title">{{ misc.awardsHeading | escape }}</p>
{% for award in misc.awards | sortByYearDesc %}
  <div class="entry">
    <div class="entry-header">
      <span class="entry-title">{{ award.title | escape }}</span>
      <span class="entry-date">{{ award.year }}</span>
    </div>
    <div class="entry-subtitle">
      {{ award.subtitle | escape }} · {{ award.organizer | escape }}
    </div>
  </div>
{% endfor %}

<p class="section-title">{{ misc.patentsHeading | escape }}</p>
{% for patent in misc.patents | sortByYearDesc %}
  <div class="entry">
    <div class="entry-header">
      <span class="entry-title">{{ patent.title | escape }}</span>
      <span class="entry-date">{{ patent.year }}</span>
    </div>
    <div class="entry-subtitle">
      {{ ui.patent.label | escape }} · {{ ui.patent.applicationNumber | escape }}: {{ patent.applicationNumber | escape }} · {{ ui.patent.filed | escape }}: {{ patent.filed | escape }}
    </div>
  </div>
{% endfor %}

<p class="section-title">{{ misc.skillsHeading | escape }}</p>
<div class="entry">
  {% for group in misc.skillGroups %}
    <div style="margin-bottom: 8px; font-size: var(--fs-sm); color: var(--c-text-2)">
      <strong style="color: var(--c-text)">{{ group.label | escape }}:</strong>
      {% for value in group.values %}{{ value | escape }}{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
  {% endfor %}
</div>
